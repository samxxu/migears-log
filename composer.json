{
    "name": "migears/log",
    "description": "Minimalist PSR-3 compliant logger",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "log",
        "logger",
        "psr-3",
        "logging",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Log\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
